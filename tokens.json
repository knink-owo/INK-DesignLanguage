{
  "name": "INK Design Language",
  "version": "1.0.0",
  "description": "个人设计语言：纸白底、墨黑字、八个色场、直角与 1px 线。先感受，再解释。",
  "prefix": "--ink-",
  "source": "tokens.css",
  "colors": {
    "lake": { "var": "--ink-lake", "value": "#6EA8A3", "role": "主强调 / 链接 / 主操作" },
    "sky": { "var": "--ink-sky", "value": "#87B9CE", "role": "信息 / 说明" },
    "moss": { "var": "--ink-moss", "value": "#8FB394", "role": "完成 / 通过" },
    "lotus": { "var": "--ink-lotus", "value": "#A995C4", "role": "创作 / 草稿" },
    "wheat": { "var": "--ink-wheat", "value": "#D2B173", "role": "标记 / 他人" },
    "clay": { "var": "--ink-clay", "value": "#CE927C", "role": "提醒 / 受阻" },
    "stone": { "var": "--ink-stone", "value": "#94A7B0", "role": "系统 / 中性分区" },
    "rouge": { "var": "--ink-rouge", "value": "#C98D9B", "role": "错误 / 危险" },
    "canvas": { "var": "--ink-canvas", "value": "#FAF9F5", "role": "页面底色" },
    "surface": { "var": "--ink-surface", "value": "#FFFFFF", "role": "卡片 / 面板 / 对话框" },
    "ink": { "var": "--ink-ink", "value": "#26302C", "role": "正文 / 主按钮背景" },
    "ink-secondary": { "var": "--ink-ink-secondary", "value": "#5E6A64", "role": "次要文字" },
    "ink-muted": { "var": "--ink-ink-muted", "value": "#8B948E", "role": "弱化文字（仅装饰）" },
    "line": { "var": "--ink-line", "value": "#E5E8E1", "role": "1px 分割线" },
    "text-primary": { "var": "--ink-text-primary", "value": "#26302C", "role": "正文文字" },
    "text-secondary": { "var": "--ink-text-secondary", "value": "#5E6A64", "role": "次要文字" },
    "text-on-color": { "var": "--ink-text-on-color", "value": "#16211D", "role": "色场上的文字" },
    "text-on-ink": { "var": "--ink-text-on-ink", "value": "#FFFFFF", "role": "墨黑底上的文字" },
    "focus": { "var": "--ink-focus", "value": "#16211D", "role": "焦点环" },
    "control-border": { "var": "--ink-control-border", "value": "#5E6A64", "role": "输入控件边框" }
  },
  "typography": {
    "font": {
      "body": { "var": "--ink-font", "value": "\"Segoe UI\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", system-ui, sans-serif" },
      "display": { "var": "--ink-font-display", "value": "\"Segoe UI Light\", \"Segoe UI\", \"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", system-ui, sans-serif" },
      "mono": { "var": "--ink-font-mono", "value": "\"Cascadia Code\", \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace" }
    },
    "weight": {
      "display": { "var": "--ink-weight-display", "value": 300 },
      "body": { "var": "--ink-weight-body", "value": 400 },
      "kicker": { "var": "--ink-weight-kicker", "value": 600 },
      "strong": { "var": "--ink-weight-strong", "value": 600 }
    },
    "size": {
      "display": { "var": "--ink-size-display", "value": "clamp(3rem, 7.2vw, 5.75rem)" },
      "h1": { "var": "--ink-size-h1", "value": "clamp(2.25rem, 4.2vw, 3.5rem)" },
      "h2": { "var": "--ink-size-h2", "value": "clamp(1.5rem, 2.6vw, 2.25rem)" },
      "h3": { "var": "--ink-size-h3", "value": "clamp(1.125rem, 1.6vw, 1.375rem)" },
      "body": { "var": "--ink-size-body", "value": "1rem" },
      "small": { "var": "--ink-size-small", "value": "0.875rem" },
      "kicker": { "var": "--ink-size-kicker", "value": "0.6875rem" }
    },
    "leading": {
      "display": { "var": "--ink-leading-display", "value": 1.05 },
      "heading": { "var": "--ink-leading-heading", "value": 1.2 },
      "body": { "var": "--ink-leading-body", "value": 1.75 }
    },
    "tracking": {
      "kicker": { "var": "--ink-tracking-kicker", "value": "2.4px" },
      "display": { "var": "--ink-tracking-display", "value": "-0.02em" }
    }
  },
  "spacing": {
    "1": { "var": "--ink-space-1", "value": "4px" },
    "2": { "var": "--ink-space-2", "value": "8px" },
    "3": { "var": "--ink-space-3", "value": "12px" },
    "4": { "var": "--ink-space-4", "value": "16px" },
    "5": { "var": "--ink-space-5", "value": "24px" },
    "6": { "var": "--ink-space-6", "value": "32px" },
    "7": { "var": "--ink-space-7", "value": "48px" },
    "8": { "var": "--ink-space-8", "value": "64px" },
    "9": { "var": "--ink-space-9", "value": "96px" },
    "10": { "var": "--ink-space-10", "value": "128px" }
  },
  "layout": {
    "radius": { "var": "--ink-radius", "value": "0px" },
    "wrap": { "var": "--ink-wrap", "value": "1200px" },
    "gutter": { "var": "--ink-gutter", "value": "clamp(20px, 5vw, 64px)" },
    "headerHeight": { "var": "--ink-header-h", "value": "64px" },
    "targetMin": { "var": "--ink-target-min", "value": "44px" },
    "focusWidth": { "var": "--ink-focus-width", "value": "2px" },
    "focusOffset": { "var": "--ink-focus-offset", "value": "4px" },
    "border": { "var": "--ink-border", "value": "1px solid var(--ink-line)" },
    "borderStrong": { "var": "--ink-border-strong", "value": "1px solid var(--ink-ink)" },
    "overlay": { "var": "--ink-overlay", "value": "rgba(22, 33, 29, 0.34)" }
  },
  "shadow": {
    "0": { "var": "--ink-shadow-0", "value": "none" },
    "1": { "var": "--ink-shadow-1", "value": "none" },
    "2": { "var": "--ink-shadow-2", "value": "0 10px 30px rgba(38, 48, 44, 0.12)" },
    "3": { "var": "--ink-shadow-3", "value": "0 22px 60px rgba(38, 48, 44, 0.16)" },
    "4": { "var": "--ink-shadow-4", "value": "0 36px 96px rgba(38, 48, 44, 0.20)" }
  },
  "z": {
    "floating": { "var": "--ink-z-floating", "value": 20 },
    "panel": { "var": "--ink-z-panel", "value": 40 },
    "modal": { "var": "--ink-z-modal", "value": 60 }
  },
  "acrylic": {
    "blur": { "var": "--ink-acrylic-blur", "value": "16px" },
    "opacity": { "var": "--ink-acrylic-opacity", "value": 0.84 },
    "background": { "var": "--ink-acrylic-background", "value": "rgba(250, 249, 245, 0.84)" },
    "border": { "var": "--ink-acrylic-border", "value": "rgba(255, 255, 255, 0.45)" }
  },
  "motion": {
    "easing": {
      "in": { "var": "--ink-ease-in", "value": "cubic-bezier(0.1, 0.9, 0.2, 1)" },
      "out": { "var": "--ink-ease-out", "value": "cubic-bezier(0.7, 0, 1, 0.5)" },
      "snap": { "var": "--ink-ease-snap", "value": "cubic-bezier(0.17, 0.89, 0.32, 1.18)" }
    },
    "duration": {
      "hover": { "var": "--ink-duration-hover", "value": "200ms" },
      "press": { "var": "--ink-duration-press", "value": "140ms" },
      "expand": { "var": "--ink-duration-expand", "value": "380ms" },
      "page": { "var": "--ink-duration-page", "value": "420ms" }
    },
    "stagger": { "var": "--ink-stagger", "value": "45ms" },
    "hoverLift": { "var": "--ink-hover-lift", "value": "-3px" },
    "pressScale": { "var": "--ink-press-scale", "value": 0.975 }
  },
  "breakpoints": {
    "compact": "980px",
    "narrow": "680px"
  }
}
